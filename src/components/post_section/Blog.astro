---
import BlogCarousel from "./BlogCarousel";

// `posts` arrive pre-sorted with { title, date, url, excerpt }.
const { posts } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="container mx-auto px-4 h-full flex flex-col pt-20 pb-8">
  <!-- Title + carousel centered together as one group (title hugs the content) -->
  <div class="flex-1 min-h-0 overflow-hidden flex flex-col justify-center">
    <div class="mb-4 flex-shrink-0 flex items-end justify-between gap-4">
      <div>
        <h1
          class="text-4xl lg:text-5xl font-display font-bold section-heading text-text dark:text-dk-text"
        >
          Blog
        </h1>
        <p class="mt-4 text-text/50 dark:text-dk-text/50 text-lg">
          Notes &amp; paper reading on GenAI, RAG, and the systems I build.
        </p>
      </div>
      <a
        href={`${base}posts`}
        class="flex-shrink-0 inline-flex items-center gap-1.5 text-secondary hover:text-accent font-semibold text-sm"
      >
        All Posts
        <i class="fas fa-arrow-right text-xs"></i>
      </a>
    </div>
    <div class="flex-shrink-0">
      <BlogCarousel posts={posts} client:only="react" />
    </div>
  </div>
</div>
