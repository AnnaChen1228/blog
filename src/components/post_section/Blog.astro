---
import BlogCarousel from "./BlogCarousel";

// `posts` arrive pre-sorted with { title, date, url, excerpt }.
const { posts } = Astro.props;
const base = import.meta.env.BASE_URL; // "/" with no base configured
---

<div class="container mx-auto px-4 h-full flex flex-col pt-20 pb-8">
  <!-- Section header -->
  <div class="mb-6 flex-shrink-0">
    <h1
      class="text-4xl lg:text-5xl font-display font-bold section-heading text-text dark:text-dk-text"
    >
      Blog
    </h1>
    <p class="mt-4 text-text/50 dark:text-dk-text/50 text-lg">
      Notes &amp; paper reading on GenAI, RAG, and the systems I build.
    </p>
  </div>

  <!-- Horizontal auto-rotating carousel (dots + All Posts share a row inside) -->
  <div class="flex-1 min-h-0 sm:overflow-hidden flex flex-col justify-center">
    <BlogCarousel posts={posts} client:only="react" />
  </div>
</div>
