---
const { post } = Astro.props;

const { url } = post;
const { title, description, img_path, img_alt, date } = post.frontmatter;
---

<a
  href={url}
  class="group flex flex-col h-full bg-card-bg dark:bg-dk-card-bg rounded-2xl overflow-hidden border border-secondary/20 hover:border-secondary/50 shadow-sm hover:shadow-md hover:shadow-secondary/10 hover:-translate-y-1 transition-all duration-300"
>
  {
    img_path && (
      <img
        class="w-full h-40 object-cover"
        src={img_path}
        alt={img_alt || title}
        width="300"
        height="200"
      />
    )
  }

  <div class="flex-1 flex flex-col p-5">
    <h5 class="text-lg font-display font-bold text-text dark:text-dk-text group-hover:text-secondary dark:group-hover:text-dk-secondary transition-colors line-clamp-2">
      {title}
    </h5>

    {
      description && (
        <p class="mt-2 text-sm text-text/60 dark:text-dk-text/60 leading-relaxed line-clamp-3">
          {description}
        </p>
      )
    }

    <div class="flex items-center justify-between gap-2 mt-auto pt-3 border-t border-secondary/10">
      <span class="inline-flex items-center gap-1.5 text-secondary group-hover:text-accent font-semibold text-sm">
        Read more
        <i class="fas fa-arrow-right text-xs group-hover:translate-x-1 transition-transform duration-200" />
      </span>
      <span class="text-xs text-text/40 dark:text-dk-text/40 font-medium flex-shrink-0">
        {date}
      </span>
    </div>
  </div>
</a>
