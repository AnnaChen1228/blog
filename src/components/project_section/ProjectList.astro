---
import ProjectCarousel from "./ProjectCarousel";

const { projects } = Astro.props;
---

<div class="container mx-auto px-4 h-full flex flex-col pt-20 pb-8">
  <!-- Title + carousel centered together as one group -->
  <div class="flex-1 min-h-0 overflow-hidden flex flex-col justify-center">
    <div class="mb-4 flex-shrink-0">
      <h1
        class="text-4xl lg:text-5xl font-display font-bold section-heading text-text dark:text-dk-text"
      >
        Projects
      </h1>
      <p class="mt-4 text-text/50 dark:text-dk-text/50 text-lg">Things I've built</p>
    </div>
    <div class="min-h-0">
      <ProjectCarousel projects={projects} client:only="react" />
    </div>
  </div>
</div>
